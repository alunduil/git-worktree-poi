{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>alunduil/renovate-config",
    "github>alunduil/renovate-config:automerge-workflow-majors",
    "github>alunduil/renovate-config:automerge-minor"
  ],
  "packageRules": [
    {
      "description": "'Check dependency policy' runs cargo-deny against deny.toml in a required check, which catches a broken 0.x update before merge",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["patch", "minor"],
      "matchDepNames": ["cargo-deny"],
      "automerge": true
    }
  ]
}
