{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>alunduil/renovate-config",
    "github>alunduil/renovate-config:automerge-workflow-majors",
    "github>alunduil/renovate-config:automerge-minor"
  ],
  "packageRules": [
    {
      "description": "'Check dependency policy' runs cargo-deny against deny.toml, so a 0.x update that breaks the policy check fails CI",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["patch", "minor"],
      "matchDepNames": ["cargo-deny"],
      "automerge": true
    }
  ]
}
